---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Lost in the Arena">
    <div class="error-container">
        <div class="terminal-404">
            <div class="terminal-header">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
            </div>
            <div class="terminal-body">
                <p class="prompt">guest@winston.io:~$ <span class="command">look --around</span></p>
                <!-- The error code is the page's heading — screen readers need one
                     landmark heading, and the terminal styling is preserved. -->
                <h1 class="error-code">HTTP 404: RESOURCE_NOT_FOUND</h1>
                <p class="error-msg">You have drifted outside the Arena. The requested coordinate does not exist in the current simulation.</p>
                <div class="nav-links">
                    <p><span class="prompt">></span> <a href="/">cd /home</a></p>
                    <p><span class="prompt">></span> <a href="/portfolio/">cd /portfolio</a></p>
                    <p><span class="prompt">></span> <a href="/writing/">cd /writing</a></p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .error-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        padding: 2rem;
    }

    .terminal-404 {
        width: 100%;
        max-width: 600px;
        background: rgba(10, 10, 15, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        overflow: hidden;
        font-family: 'JetBrains Mono', monospace;
    }

    .terminal-header {
        background: rgba(255, 255, 255, 0.05);
        padding: 12px;
        display: flex;
        gap: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

    .dot.red { background: #ff5f56; }
    .dot.yellow { background: #ffbd2e; }
    .dot.green { background: #27c93f; }

    .terminal-body {
        padding: 2rem;
        line-height: 1.6;
        /* terminal.css is imported globally for the homepage's interactive
           terminal and pins .terminal-body to height:220px + overflow-y:auto.
           On this page that clipped the escape links out of the box — the one
           thing a 404 has to show. Let it size to its content instead. */
        height: auto;
        overflow: visible;
    }

    .prompt { color: #3b82f6; margin-right: 8px; }
    .command { color: #fff; }
    .error-code { color: #ef4444; font-weight: bold; margin: 1rem 0; font-size: 1.2rem; }
    .error-msg { color: var(--text-muted); margin-bottom: 2rem; }

    .nav-links p { margin: 0.5rem 0; }
    
    .nav-links a {
        color: #ec4899;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .nav-links a:hover {
        color: #fff;
        text-shadow: 0 0 10px rgba(236, 72, 153, 0.5);
    }
</style>
