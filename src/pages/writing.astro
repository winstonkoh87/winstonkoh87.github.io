---
import Layout from '../layouts/Layout.astro';
import { ARTICLES, CLUSTERS, type ClusterId } from '../data/writing-taxonomy';

// Group articles by cluster
const articlesByCluster = ARTICLES.reduce((acc, article) => {
    if (!acc[article.cluster]) {
        acc[article.cluster] = [];
    }
    acc[article.cluster].push(article);
    return acc;
}, {} as Record<ClusterId, typeof ARTICLES>);

// Get cluster keys in specific order
const clusterKeys: ClusterId[] = ['sovereign-systems', 'strategic-engineering', 'economics-of-leverage', 'case-files'];
---

<Layout title="Writing | AI Strategy & Engineering Insights [2026]" description="Strategic insights on AI architecture, sovereign systems, and the bionic workflow. Decoding the physics of digital leverage and survival in the automation age.">
    <section class="page-content">
        <section class="page-header">
            <div class="header-row">
                <div class="header-text">
                    <h1>Writing</h1>
                    <p class="page-subtitle">Thoughts on systems, strategy, and survival.</p>
                </div>
            </div>

            <!-- Filter Controls (Client-Side) -->
            <div class="filter-controls fade-in-delayed-2">
                <button class="filter-btn active" data-filter="all">All</button>
                {clusterKeys.map((key) => (
                    <button class="filter-btn" data-filter={key}>{CLUSTERS[key].title}</button>
                ))}
            </div>
        </section>

        <!-- Filter Logic Script -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const buttons = document.querySelectorAll('.filter-btn');
                const sections = document.querySelectorAll('.cluster-section');

                buttons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        // 1. Toggle Active State
                        buttons.forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');

                        // 2. Filter Sections
                        const filter = btn.getAttribute('data-filter');
                        
                        sections.forEach(section => {
                            if (filter === 'all' || section.id === filter) {
                                (section as HTMLElement).style.display = 'block';
                                (section as HTMLElement).style.animation = 'fadeIn 0.5s ease forwards';
                            } else {
                                (section as HTMLElement).style.display = 'none';
                            }
                        });
                    });
                });
            });
        </script>

        <section class="content-section">
            <div class="hub-container">
                {clusterKeys.map((key) => {
                    const cluster = CLUSTERS[key];
                    const articles = articlesByCluster[key] || [];
                    
                    if (articles.length === 0) return null;

                    return (
                        <div class="cluster-section" id={key}>
                            <div class="cluster-header">
                                <span class="cluster-subtitle">{cluster.subtitle}</span>
                                <h2 class="section-title">{cluster.title}</h2>
                                <p class="cluster-description">{cluster.description}</p>
                            </div>
                            
                            <div class="article-grid">
                                {articles.map((article) => (
                                    <article class="article-card" data-category={article.cluster} data-date={article.date}>
                                        <a href={`/articles/${article.slug}`} class="article-link">
                                            <div class="article-image-wrapper">
                                                <img 
                                                    src={article.image} 
                                                    alt={article.title}
                                                    class="article-image"
                                                    loading="lazy"
                                                />
                                                <div class="article-tags-overlay">
                                                    {article.tags.map((tag) => (
                                                        <span class="article-tag-pill">{tag}</span>
                                                    ))}
                                                </div>
                                            </div>
                                            <div class="article-card-content">
                                                <span class="article-date">{new Date(article.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
                                                <h3>{article.title}</h3>
                                            </div>
                                        </a>
                                    </article>
                                ))}
                            </div>
                        </div>
                    );
                })}
            </div>
        </section>

        <section class="content-section">
            <h2>Topics I'll Cover</h2>
            <ul class="topic-list">
                <li>Arena selection and the physics of survival</li>
                <li>Building systems that compound over time</li>
                <li>AI as a bionic layer, not a replacement</li>
                <li>Navigating hostile environments without self-destruction</li>
                <li>The economics of attention, status, and leverage</li>
            </ul>
        </section>
    </section>
</Layout>

<style>
    /* Cluster Section Styling */
    .cluster-section {
        margin-bottom: 5rem;
    }
    
    .cluster-header {
        margin-bottom: 2.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 1.5rem;
    }

    .cluster-subtitle {
        color: var(--accent);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        display: block;
        margin-bottom: 0.5rem;
    }

    .cluster-header h2 {
        font-size: 2rem;
        margin: 0 0 0.5rem 0;
        color: var(--text-primary);
        font-weight: 700;
    }

    .cluster-description {
        color: var(--text-secondary);
        font-size: 1rem;
        max-width: 550px;
        margin: 0;
        line-height: 1.6;
    }

    /* Filter Controls */
    .filter-controls {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-secondary);
        padding: 0.5rem 1.25rem;
        border-radius: 99px;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: 'Inter', sans-serif;
    }

    .filter-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-primary);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .filter-btn.active {
        background: var(--text-primary);
        color: var(--bg-primary);
        border-color: var(--text-primary);
        font-weight: 600;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Article Grid - Adverdize Style */
    .article-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    @media (max-width: 1024px) {
        .article-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .article-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Article Card - Image First */
    .article-card {
        background: transparent;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .article-card:hover {
        transform: translateY(-4px);
    }

    .article-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    /* Image Wrapper */
    .article-image-wrapper {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: 12px;
        background: var(--bg-secondary);
    }

    .article-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .article-card:hover .article-image {
        transform: scale(1.05);
    }

    /* Tag Pills Overlay */
    .article-tags-overlay {
        position: absolute;
        bottom: 12px;
        left: 12px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .article-tag-pill {
        background: rgba(255, 255, 255, 0.95);
        color: #111;
        padding: 6px 14px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        backdrop-filter: blur(4px);
    }

    /* Card Content */
    .article-card-content {
        padding: 1.25rem 0.25rem 0.5rem;
    }

    .article-date {
        color: var(--accent);
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: block;
        margin-bottom: 0.5rem;
    }

    .article-card-content h3 {
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.4;
        color: var(--text-primary);
        margin: 0;
        transition: color 0.2s ease;
    }

    .article-card:hover .article-card-content h3 {
        color: var(--accent);
    }

    @media (max-width: 768px) {
        .cluster-header h2 {
            font-size: 1.5rem;
        }
        
        .article-card-content h3 {
            font-size: 1rem;
        }

        .cluster-section {
            margin-bottom: 4rem;
        }
    }
</style>
