---
import Layout from '../layouts/Layout.astro';
import { ARTICLES, CLUSTERS, type ClusterId } from '../data/writing-taxonomy';

// Group articles by cluster
const articlesByCluster = ARTICLES.reduce((acc, article) => {
    if (!acc[article.cluster]) {
        acc[article.cluster] = [];
    }
    acc[article.cluster].push(article);
    return acc;
}, {} as Record<ClusterId, typeof ARTICLES>);

// Get cluster keys in specific order
const clusterKeys: ClusterId[] = ['sovereign-systems', 'strategic-engineering', 'economics-of-leverage', 'case-files'];

// Get featured/latest article for hero (optional, taking the first one marked featured or just the first one)
const featuredArticle = ARTICLES.find(a => a.featured) || ARTICLES[0];
---

<Layout title="Writing | AI Strategy & Engineering Insights [2026]" description="Strategic insights on AI architecture, sovereign systems, and the bionic workflow. Decoding the physics of digital leverage and survival in the automation age.">
    <section class="page-content">
        <section class="page-header">
            <div class="header-row">
                <div class="header-text">
                    <h1>Writing</h1>
                    <p class="page-subtitle">Thoughts on systems, strategy, and survival.</p>
                </div>
                <!-- Search could go here if needed later, removing manual filters for now to focus on structure -->
            </div>
        </section>

        <section class="content-section">
            <div class="hub-container">
                {clusterKeys.map((key) => {
                    const cluster = CLUSTERS[key];
                    const articles = articlesByCluster[key] || [];
                    
                    if (articles.length === 0) return null;

                    return (
                        <div class="cluster-section" id={key}>
                            <div class="cluster-header">
                                <span class="cluster-subtitle">{cluster.subtitle}</span>
                                <h2>{cluster.title}</h2>
                                <p class="cluster-description">{cluster.description}</p>
                            </div>
                            
                            <div class="article-grid">
                                {articles.map((article) => (
                                    <article class="article-card" data-category={article.cluster} data-date={article.date}>
                                        <a href={`/articles/${article.slug}`} class="article-link">
                                            <div class="article-card-content">
                                                <div class="article-meta">
                                                    <span class="article-date">{new Date(article.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
                                                    <span class="article-tag">{article.tags[0]}</span>
                                                </div>
                                                <h3>{article.title}</h3>
                                                <p class="article-excerpt">{article.excerpt}</p>
                                                <span class="read-more">Read article →</span>
                                            </div>
                                        </a>
                                    </article>
                                ))}
                            </div>
                        </div>
                    );
                })}
            </div>
        </section>

        <section class="content-section">
            <h2>Topics I'll Cover</h2>
            <ul class="topic-list">
                <li>Arena selection and the physics of survival</li>
                <li>Building systems that compound over time</li>
                <li>AI as a bionic layer, not a replacement</li>
                <li>Navigating hostile environments without self-destruction</li>
                <li>The economics of attention, status, and leverage</li>
            </ul>
        </section>
    </section>

    <!-- Removing writing-filters.js as we are now using a structural layout -->
</Layout>

<style>
    /* Add some specific styles for the hub layout */
    .cluster-section {
        margin-bottom: 6rem;
    }
    
    .cluster-header {
        margin-bottom: 2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 1rem;
    }

    .cluster-subtitle {
        color: var(--accent);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        display: block;
        margin-bottom: 0.5rem;
    }

    .cluster-header h2 {
        font-size: 2rem;
        margin: 0 0 0.5rem 0;
        color: var(--text-primary);
    }

    .cluster-description {
        color: var(--text-secondary);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0;
    }

    @media (max-width: 768px) {
        .cluster-header h2 {
            font-size: 1.5rem;
        }
    }
</style>
