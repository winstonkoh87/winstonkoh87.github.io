---
import Layout from '../layouts/Layout.astro';
import { ARTICLES, CLUSTERS, type ClusterId } from '../data/writing-taxonomy';

// Group articles by cluster and sort each group by date (newest first)
const articlesByCluster = ARTICLES.reduce((acc, article) => {
    if (!acc[article.cluster]) {
        acc[article.cluster] = [];
    }
    acc[article.cluster].push(article);
    return acc;
}, {} as Record<ClusterId, typeof ARTICLES>);

// Sort each cluster's articles by date (newest first)
Object.keys(articlesByCluster).forEach(key => {
    articlesByCluster[key as ClusterId].sort((a, b) => 
        new Date(b.date).getTime() - new Date(a.date).getTime()
    );
});

// Get cluster keys in specific order
const clusterKeys: ClusterId[] = ['sovereign-systems', 'strategic-engineering', 'economics-of-leverage', 'case-files', 'ai-for-business'];
---

<Layout title="Writing | AI Strategy & Engineering Insights [2026]" description="Strategic insights on AI architecture, sovereign systems, and the bionic workflow. Decoding the physics of digital leverage and survival in the automation age.">
    <section class="page-content">
        <section class="page-header">
            <div class="header-row">
                <div class="header-text">
                    <h1>Writing</h1>
                    <p class="page-subtitle">Thoughts on systems, strategy, and survival.</p>
                </div>
            </div>

            <!-- Filter Controls (Client-Side) -->
            <div class="filter-controls fade-in-delayed-2">
                <button class="filter-btn active" data-filter="all">All</button>
                {clusterKeys.map((key) => (
                    <button class="filter-btn" data-filter={key}>{CLUSTERS[key].title}</button>
                ))}
            </div>
        </section>

        <section class="content-section">
            <div class="hub-container">
                {clusterKeys.map((key) => {
                    const cluster = CLUSTERS[key];
                    const articles = articlesByCluster[key] || [];
                    
                    if (articles.length === 0) return null;

                    // Chunk articles into groups of 6 for 2x3 slides
                    const chunkSize = 6;
                    const slides = [];
                    for (let i = 0; i < articles.length; i += chunkSize) {
                        slides.push(articles.slice(i, i + chunkSize));
                    }

                    return (
                        <div class="cluster-section" id={key}>
                            <div class="cluster-header">
                                <span class="cluster-subtitle">{cluster.subtitle}</span>
                                <h2 class="section-title">{cluster.title}</h2>
                                <p class="cluster-description">{cluster.description}</p>
                            </div>
                            
                            <div class="carousel-container" data-cluster={key}>
                                <div class="carousel-track">
                                    {slides.map((slideArticles, index) => (
                                        <div class="carousel-slide" data-index={index}>
                                            <div class="article-grid">
                                                {slideArticles.map((article) => (
                                                    <article class="article-card" data-category={article.cluster} data-date={article.date}>
                                                        <a href={`/articles/${article.slug}/`} class="article-link">
                                                            <div class="article-image-wrapper">
                                                                <img 
                                                                    src={article.image} 
                                                                    alt={article.title}
                                                                    class="article-image"
                                                                    loading="lazy"
                                                                />
                                                                <div class="article-tags-overlay">
                                                                    {article.tags.map((tag) => (
                                                                        <span class="article-tag-pill">{tag}</span>
                                                                    ))}
                                                                </div>
                                                            </div>
                                                            <div class="article-card-content">
                                                                <span class="article-date">{new Date(article.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
                                                                <h3>{article.title}</h3>
                                                            </div>
                                                        </a>
                                                    </article>
                                                ))}
                                            </div>
                                        </div>
                                    ))}
                                </div>

                                {slides.length > 1 && (
                                    <div class="carousel-nav">
                                        <button class="nav-btn prev" aria-label="Previous Slide" disabled>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                                        </button>
                                        <div class="nav-dots">
                                            {slides.map((_, i) => (
                                                <span class={`nav-dot ${i === 0 ? 'active' : ''}`} data-index={i}></span>
                                            ))}
                                        </div>
                                        <button class="nav-btn next" aria-label="Next Slide">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                        </button>
                                    </div>
                                )}
                            </div>
                        </div>
                    );
                })}
            </div>
        </section>

        <!-- Carousel & Filter Logic -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // --- Filter Logic ---
                const filterButtons = document.querySelectorAll('.filter-btn');
                const sections = document.querySelectorAll('.cluster-section');

                filterButtons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        filterButtons.forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');

                        const filter = btn.getAttribute('data-filter');
                        
                        sections.forEach(section => {
                            if (filter === 'all' || section.id === filter) {
                                (section as HTMLElement).style.display = 'block';
                                (section as HTMLElement).style.animation = 'fadeIn 0.5s ease forwards';
                            } else {
                                (section as HTMLElement).style.display = 'none';
                            }
                        });
                    });
                });

                // --- Carousel Logic ---
                const carousels = document.querySelectorAll('.carousel-container');

                carousels.forEach(container => {
                    const track = container.querySelector('.carousel-track') as HTMLElement;
                    const slides = container.querySelectorAll('.carousel-slide');
                    const nextBtn = container.querySelector('.nav-btn.next');
                    const prevBtn = container.querySelector('.nav-btn.prev');
                    const dots = container.querySelectorAll('.nav-dot');

                    if (!track || slides.length <= 1) return;

                    let currentIndex = 0;

                    const updateCarousel = () => {
                        const offset = currentIndex * -100;
                        track.style.transform = `translateX(${offset}%)`;

                        // Update Buttons
                        if (prevBtn) (prevBtn as HTMLButtonElement).disabled = currentIndex === 0;
                        if (nextBtn) (nextBtn as HTMLButtonElement).disabled = currentIndex === slides.length - 1;

                        // Update Dots
                        dots.forEach((dot, index) => {
                            if (index === currentIndex) dot.classList.add('active');
                            else dot.classList.remove('active');
                        });
                    };

                    if (nextBtn) {
                        nextBtn.addEventListener('click', () => {
                            if (currentIndex < slides.length - 1) {
                                currentIndex++;
                                updateCarousel();
                            }
                        });
                    }

                    if (prevBtn) {
                        prevBtn.addEventListener('click', () => {
                            if (currentIndex > 0) {
                                currentIndex--;
                                updateCarousel();
                            }
                        });
                    }

                    // Dot Navigation
                    dots.forEach((dot, index) => {
                        dot.addEventListener('click', () => {
                            currentIndex = index;
                            updateCarousel();
                        });
                    });
                });
            });
        </script>

        <section class="content-section">
            <h2>Topics I'll Cover</h2>
            <ul class="topic-list">
                <li>Arena selection and the physics of survival</li>
                <li>Building systems that compound over time</li>
                <li>AI as a bionic layer, not a replacement</li>
                <li>Navigating hostile environments without self-destruction</li>
                <li>The economics of attention, status, and leverage</li>
            </ul>
        </section>
    </section>
</Layout>

<style>
    /* Cluster Section Styling */
    .cluster-section {
        margin-bottom: 5rem;
    }
    
    .cluster-header {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .cluster-subtitle {
        color: var(--accent);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        display: block;
        margin-bottom: 0.5rem;
    }

    .cluster-header h2 {
        font-size: 2rem;
        margin: 0 0 0.5rem 0;
        color: var(--text-primary);
        font-weight: 700;
    }

    .cluster-description {
        color: var(--text-secondary);
        font-size: 1rem;
        max-width: 600px;
        margin: 0;
        line-height: 1.6;
    }

    /* Filter Controls */
    .filter-controls {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-secondary);
        padding: 0.5rem 1.25rem;
        border-radius: 99px;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: 'Inter', sans-serif;
    }

    .filter-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-primary);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .filter-btn.active {
        background: var(--text-primary);
        color: var(--bg-primary);
        border-color: var(--text-primary);
        font-weight: 600;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* --- Carousel Components --- */
    .carousel-container {
        position: relative;
        overflow: hidden; /* Mask overflow for sliding */
        padding-bottom: 2rem; /* Space for Nav */
    }

    .carousel-track {
        display: flex;
        width: 100%;
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); /* Premium Ease */
    }

    .carousel-slide {
        min-width: 100%; /* Each slide takes full container width */
        box-sizing: border-box;
    }

    /* Carousel Navigation */
    .carousel-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    .nav-btn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--text-primary);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .nav-btn:hover:not(:disabled) {
        background: var(--text-primary);
        color: var(--bg-primary);
        border-color: var(--text-primary);
    }

    .nav-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
        border-color: rgba(255, 255, 255, 0.1);
    }

    .nav-dots {
        display: flex;
        gap: 8px;
    }

    .nav-dot {
        width: 8px;
        height: 8px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .nav-dot.active {
        background: var(--accent);
        transform: scale(1.2);
    }

    .nav-dot:hover {
        background: rgba(255, 255, 255, 0.5);
    }

    /* Article Grid - 2x3 Layout within Slide */
    .article-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(2, 1fr); /* Enforce 2 rows */
        gap: 2rem;
    }

    @media (max-width: 1024px) {
        .article-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .article-grid {
            grid-template-columns: 1fr;
            grid-template-rows: auto;
        }
        
        .carousel-track {
            transform: none !important; /* Disable CSS transform on mobile if needed, but keeping consistent is better */
        }
    }

    /* Article Card - Image First */
    .article-card {
        background: transparent;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%; /* Fill grid cell */
        display: flex;
        flex-direction: column;
    }

    .article-card:hover {
        transform: translateY(-4px);
    }

    .article-link {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    /* Image Wrapper */
    .article-image-wrapper {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: 12px;
        background: var(--bg-secondary);
    }

    .article-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .article-card:hover .article-image {
        transform: scale(1.05);
    }

    /* Tag Pills Overlay */
    .article-tags-overlay {
        position: absolute;
        bottom: 12px;
        left: 12px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .article-tag-pill {
        background: rgba(255, 255, 255, 0.95);
        color: #111;
        padding: 6px 14px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        backdrop-filter: blur(4px);
    }

    /* Card Content */
    .article-card-content {
        padding: 1.25rem 0.25rem 0.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .article-date {
        color: var(--accent);
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: block;
        margin-bottom: 0.5rem;
    }

    .article-card-content h3 {
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.4;
        color: var(--text-primary);
        margin: 0;
        transition: color 0.2s ease;
    }

    .article-card:hover .article-card-content h3 {
        color: var(--accent);
    }

    @media (max-width: 768px) {
        .cluster-header h2 {
            font-size: 1.5rem;
        }
        
        .article-card-content h3 {
            font-size: 1rem;
        }

        .cluster-section {
            margin-bottom: 4rem;
        }
        
        /* On mobile, maybe allow simple scroll fallback or just carousel */
        /* Carousel fits okay on mobile if 1 column */
    }
</style>
