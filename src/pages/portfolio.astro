---
import Layout from '../layouts/Layout.astro';
import { PROJECTS, CLUSTERS, type ClusterId } from '../data/portfolio-taxonomy';

// Group projects by cluster
const projectsByCluster = PROJECTS.reduce((acc, project) => {
    if (!acc[project.cluster]) {
        acc[project.cluster] = [];
    }
    acc[project.cluster].push(project);
    return acc;
}, {} as Record<ClusterId, typeof PROJECTS>);

// Order of clusters
const clusterKeys: ClusterId[] = ['autonomous-systems', 'strategic-infrastructure', 'commerce-conversion'];
---

<Layout title="Portfolio | AI Systems & Bionic Workflows" description="Explore a portfolio of autonomous AI systems, reliable web infrastructure, and strategic digital assets. Case studies in velocity, system architecture, and outcome-based engineering.">
    <section class="page-content">
        <section class="page-header">
            <div class="header-row">
                <div class="header-text">
                    <h1>Portfolio</h1>
                    <p class="page-subtitle">Projects, demos, and case studies.</p>
                </div>
            </div>
            
            <!-- Filter Controls (Client-Side) -->
            <div class="filter-controls fade-in-delayed-2">
                <button class="filter-btn active" data-filter="all">All</button>
                {clusterKeys.map((key) => (
                    <button class="filter-btn" data-filter={key}>{CLUSTERS[key].title}</button>
                ))}
            </div>

            <!-- Disclaimer Note -->
            <div class="portfolio-disclaimer" style="background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.3); border-radius: 8px; padding: 1rem; margin-top: 1.5rem; font-size: 0.875rem; color: var(--text-muted); max-width: 800px;">
                <strong>⚠️ Note:</strong> Some demo projects reference real individuals or businesses (e.g., "Melvin Lim", "Coach Derrick Lim", "ThatBioTutor"). These are <strong>inspired by</strong> publicly available information for demonstration purposes. All financial projections and business metrics are AI-generated estimates. <strong>These are not actual client engagements.</strong>
            </div>
        </section>

        <!-- Filter Logic Script -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const buttons = document.querySelectorAll('.filter-btn');
                const sections = document.querySelectorAll('.cluster-section');

                buttons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        // 1. Toggle Active State
                        buttons.forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');

                        // 2. Filter Sections
                        const filter = btn.getAttribute('data-filter');
                        
                        sections.forEach(section => {
                            if (filter === 'all' || section.id === filter) {
                                (section as HTMLElement).style.display = 'block';
                                (section as HTMLElement).style.animation = 'fadeIn 0.5s ease forwards';
                            } else {
                                (section as HTMLElement).style.display = 'none';
                            }
                        });
                    });
                });
            });
        </script>

        <section class="content-section">
            <div class="hub-container">
                {clusterKeys.map((key) => {
                    const cluster = CLUSTERS[key];
                    const projects = projectsByCluster[key] || [];
                    
                    if (projects.length === 0) return null;

                    return (
                        <div class="cluster-section" id={key}>
                            <div class="cluster-header">
                                <span class="cluster-subtitle">{cluster.subtitle}</span>
                                <h2>{cluster.title}</h2>
                                <p class="cluster-description">{cluster.description}</p>
                            </div>
                            
                            <div class="portfolio-grid">
                                {projects.map((project) => (
                                    <a href={project.link} target={project.target || "_self"} class="portfolio-card" data-category={project.cluster}>
                                        <div class="project-header">
                                            <span class="card-icon" aria-hidden="true">{project.icon}</span>
                                            <div style={{display: 'flex', gap: '0.5rem', alignItems: 'center'}}>
                                                <span class={`project-status ${project.status}`}>{project.status === 'production' ? 'Production' : 'Demo'}</span>
                                                {project.isLive && <span class="live-badge">● LIVE</span>}
                                            </div>
                                        </div>
                                        <h3>{project.title} {project.subtitle && <span style="font-size: 0.7em; opacity: 0.7;">{project.subtitle}</span>}</h3>
                                        <p class="project-role"><em>Role: {project.role}</em></p>
                                        <p>
                                            <strong>{project.outcome ? "The Outcome:" : "The System:"}</strong> {project.outcome || project.description}
                                            {project.outcome && <br />}
                                            {project.outcome && <span style="display:block; margin-top:0.5rem; opacity: 0.9;">{project.description}</span>}
                                        </p>
                                        <div class="project-tags">
                                            {project.tags.map(tag => (
                                                <span class="tech-tag">{tag}</span>
                                            ))}
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </div>
                    );
                })}
            </div>
        </section>

        <!-- Stats Section -->
        <div class="portfolio-stats" style="margin-top: 4rem;">
            <div class="stat-item">
                <span class="stat-number metric-value">4</span>
                <span class="stat-label">Production Systems</span>
            </div>
            <div class="stat-item">
                <span class="stat-number metric-value">5</span>
                <span class="stat-label">Demo Sites</span>
            </div>
            <div class="stat-item">
                <span class="stat-number metric-value">2</span>
                <span class="stat-label">Strategy Decks</span>
            </div>
        </div>

    </section>

    <script src="/assets/js/counter.js" is:inline></script>
</Layout>

<style>
    /* Cluster Section Styling - Matches Writing Page */
    .cluster-section {
        margin-bottom: 5rem;
    }
    
    .cluster-header {
        margin-bottom: 2.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 1.5rem;
    }

    .cluster-subtitle {
        color: var(--accent);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        display: block;
        margin-bottom: 0.5rem;
    }

    .cluster-header h2 {
        font-size: 2rem;
        margin: 0 0 0.5rem 0;
        color: var(--text-primary);
        font-weight: 700;
    }

    .cluster-description {
        color: var(--text-secondary);
        font-size: 1rem;
        max-width: 550px;
        margin: 0;
        line-height: 1.6;
    }

    /* Portfolio Grid (Adapted) */
    .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
    }

    /* Keep existing card styles but remove filtration logic dependence */
    .portfolio-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .portfolio-card:hover {
        transform: translateY(-4px);
        background: rgba(255, 255, 255, 0.05);
        border-color: var(--accent);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    }

    .project-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .card-icon {
        font-size: 2rem;
        line-height: 1;
    }

    .project-status {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.25rem 0.75rem;
        border-radius: 99px;
        font-weight: 600;
    }

    .project-status.production {
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .project-status.demo {
        background: rgba(59, 130, 246, 0.15);
        color: #3b82f6;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .live-badge {
        font-size: 0.7rem;
        color: #ef4444; 
        font-weight: 700;
        animation: pulse 2s infinite;
    }

    .portfolio-card h3 {
        font-size: 1.25rem;
        margin: 0 0 0.25rem 0;
        font-weight: 600;
        color: var(--text-primary);
    }

    .project-role {
        font-size: 0.875rem;
        color: var(--text-muted);
        margin: 0 0 1rem 0;
        font-family: 'JetBrains Mono', monospace;
    }

    .portfolio-card p {
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--text-secondary);
        margin: 0 0 1.5rem 0;
        flex-grow: 1;
    }

    .project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: auto;
    }

    .tech-tag {
        font-size: 0.75rem;
        background: rgba(255, 255, 255, 0.05);
        padding: 0.25rem 0.75rem;
        border-radius: 6px;
        color: var(--text-muted);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    @keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }

    @media (max-width: 768px) {
        .cluster-header h2 {
            font-size: 1.5rem;
        }
        .page-header h1 {
            font-size: 2.5rem;
        }
    }

    /* Filter Controls */
    .filter-controls {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-secondary);
        padding: 0.5rem 1.25rem;
        border-radius: 99px;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: 'Inter', sans-serif;
    }

    .filter-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-primary);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .filter-btn.active {
        background: var(--text-primary);
        color: var(--bg-primary); /* Invert colors for active state */
        border-color: var(--text-primary);
        font-weight: 600;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
