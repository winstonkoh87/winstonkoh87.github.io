<style>
  .sitemap-page {
    padding: 8rem 2rem;
    max-width: 1000px;
    margin: 0 auto;
    color: #e0e0e0;
  }
  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(45deg, #fff, #888);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .sitemap-subtitle {
    color: #888;
    margin-bottom: 3rem;
    font-size: 1rem;
  }
  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }
  .sitemap-section h2 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .sitemap-section ul {
    list-style: none;
    padding: 0;
  }
  .sitemap-section li {
    padding: 0.35rem 0;
  }
  .sitemap-section a {
    color: #a3a3a3;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sitemap-section a:hover {
    color: #fff;
  }
  .container {
    background: rgba(255, 255, 255, 0.03);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
</style>
