---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services | Fixed-Price AI & Full-stack Development | Winston Koh" description="Production-ready AI systems and SME websites. Landing pages, LLM integration, and bionic automation. 24-72 hour delivery with fixed pricing.">
    <!-- Services Page Specific Styles -->
    <style>
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .service-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2.5rem;
            position: relative;
            transition: border-color 0.3s, transform 0.3s;
        }

        .service-card:hover {
            border-color: var(--accent-primary);
            transform: translateY(-4px);
        }

        .service-card.featured {
            border-color: var(--accent-primary);
            background: rgba(59, 130, 246, 0.03);
        }

        .service-badge {
            position: absolute;
            top: -12px;
            right: 24px;
            background: var(--accent-primary);
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 0.35rem 0.75rem;
            border-radius: 100px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .service-icon {
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
        }

        .service-card h3 {
            font-family: 'Outfit', sans-serif;
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .service-price {
            font-size: 2rem;
            font-weight: 700;
            color: var(--accent-primary);
            margin: 1rem 0;
        }

        .service-price span {
            font-size: 1rem;
            font-weight: 400;
            color: var(--text-muted);
        }

        .service-description {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
            line-height: 1.6;
        }

        .service-features {
            list-style: none;
            margin-bottom: 1.5rem;
        }

        .service-features li {
            padding: 0.5rem 0;
            padding-left: 1.5rem;
            position: relative;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .service-features li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--accent-primary);
            font-weight: bold;
        }

        /* Mini testimonial inside service cards */
        .service-proof {
            padding: 1rem;
            margin-bottom: 1.5rem;
            background: rgba(59, 130, 246, 0.04);
            border-left: 2px solid var(--accent-primary);
            border-radius: 0 8px 8px 0;
        }

        .service-proof q {
            font-size: 0.85rem;
            font-style: italic;
            color: var(--text-muted);
            line-height: 1.5;
        }

        .service-proof cite {
            display: block;
            font-size: 0.75rem;
            color: var(--accent-primary);
            margin-top: 0.35rem;
            font-style: normal;
        }

        .service-cta {
            display: block;
            text-align: center;
            padding: 1rem;
            background: var(--accent-primary);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            transition: background 0.2s, transform 0.2s;
        }

        .service-cta:hover {
            background: #2563eb;
            transform: translateY(-2px);
        }

        .service-card.featured .service-cta {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        }

        /* Capacity Signal */
        .capacity-signal {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 0.75rem;
            padding: 0.75rem 1.25rem;
            background: rgba(100, 255, 218, 0.05);
            border: 1px solid rgba(100, 255, 218, 0.15);
            border-radius: 100px;
            font-size: 0.8rem;
            color: #64ffda;
        }

        .capacity-dot {
            width: 6px;
            height: 6px;
            background: #64ffda;
            border-radius: 50%;
            animation: capacityPulse 2s ease-in-out infinite;
        }

        @keyframes capacityPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        /* Who Is This For section */
        .persona-section {
            margin-top: 4rem;
            margin-bottom: 2rem;
        }

        .persona-section h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            text-align: center;
        }

        .persona-subtitle {
            text-align: center;
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 2rem;
        }

        .persona-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
        }

        .persona-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.75rem;
            transition: border-color 0.3s;
        }

        .persona-card:hover {
            border-color: var(--accent-primary);
        }

        .persona-emoji {
            font-size: 2rem;
            margin-bottom: 0.75rem;
        }

        .persona-card h4 {
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }

        .persona-card p {
            font-size: 0.85rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        /* Bundle Section */
        .bundle-section {
            margin-top: 4rem;
        }

        .bundle-section h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            text-align: center;
        }

        .bundle-subtitle {
            text-align: center;
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 2rem;
        }

        .bundle-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.5rem;
        }

        .bundle-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
            transition: border-color 0.3s, transform 0.3s;
        }

        .bundle-card:hover {
            border-color: var(--accent-primary);
            transform: translateY(-4px);
        }

        .bundle-card.bundle-featured {
            border-color: var(--accent-primary);
            background: rgba(59, 130, 246, 0.03);
            position: relative;
        }

        .bundle-name {
            font-family: 'Outfit', sans-serif;
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .bundle-price {
            font-size: 2rem;
            font-weight: 700;
            color: var(--accent-primary);
        }

        .bundle-original {
            font-size: 0.9rem;
            color: var(--text-muted);
            text-decoration: line-through;
            margin-left: 0.5rem;
        }

        .bundle-savings {
            display: inline-block;
            margin-top: 0.5rem;
            padding: 0.25rem 0.75rem;
            background: rgba(100, 255, 218, 0.1);
            color: #64ffda;
            border-radius: 100px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .bundle-includes {
            list-style: none;
            margin: 1.25rem 0;
            text-align: left;
        }

        .bundle-includes li {
            padding: 0.4rem 0;
            padding-left: 1.5rem;
            position: relative;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .bundle-includes li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--accent-primary);
            font-weight: bold;
        }

        .bundle-cta {
            display: block;
            text-align: center;
            padding: 0.85rem;
            background: var(--accent-primary);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.9rem;
            transition: background 0.2s, transform 0.2s;
        }

        .bundle-cta:hover {
            background: #2563eb;
            transform: translateY(-2px);
        }

        /* Guarantee Section */
        .guarantee-section {
            text-align: center;
            padding: 4rem 2rem;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            margin-top: 4rem;
        }

        .guarantee-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .guarantee-section h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 1.75rem;
            margin-bottom: 1rem;
        }

        .guarantee-section p {
            color: var(--text-muted);
            max-width: 500px;
            margin: 0 auto;
        }

        /* FAQ Quick Links */
        .services-faq {
            margin-top: 4rem;
        }

        .services-faq h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            text-align: center;
        }
    </style>

    <section class="page-content">
        <section class="page-header">
            <h1>Services</h1>
            <p class="page-subtitle">7 sites shipped. 24-72hr turnaround. Perfect Lighthouse scores.</p>
            <div class="capacity-signal">
                <span class="capacity-dot"></span>
                Currently accepting 2 new projects for Q3 2026
            </div>
        </section>

        <!-- Who Is This For? (Persona-Based Self-Selection) -->
        <section class="persona-section">
            <h2>Who Is This For?</h2>
            <p class="persona-subtitle">If one of these sounds like you, we should talk.</p>
            <div class="persona-grid">
                <div class="persona-card">
                    <div class="persona-emoji">🚀</div>
                    <h4>Founders who need to ship fast</h4>
                    <p>You have the idea and the urgency. You need a site live this week — not a 3-month agency timeline.</p>
                </div>
                <div class="persona-card">
                    <div class="persona-emoji">📈</div>
                    <h4>SMEs outgrowing Wix or Squarespace</h4>
                    <p>Your current site is slow, looks templated, and doesn't convert. You want something that performs.</p>
                </div>
                <div class="persona-card">
                    <div class="persona-emoji">🤖</div>
                    <h4>Business owners curious about AI</h4>
                    <p>You know AI can help but don't know where to start. You want someone who builds real systems, not demos.</p>
                </div>
                <div class="persona-card">
                    <div class="persona-emoji">🎯</div>
                    <h4>Marketers who want results, not reports</h4>
                    <p>You've been burned by agencies that deliver impressions but not revenue. You want leads and conversions.</p>
                </div>
            </div>
        </section>

        <section class="services-grid">
            <!-- Pillar 1: Academic Consulting (Backlink Strategy) -->
            <div class="service-card">
                <div class="service-icon">🎓</div>
                <h3>Academic Consulting</h3>
                <div class="service-price">SG Assignment Helper</div>
                <p class="service-description">
                    Premium <a href="https://sgassignmenthelp.com" target="_blank" rel="noopener noreferrer">assignment help for Singapore university students</a> — guidance and triage that deconstructs complex assignments using First Principles.
                </p>
                <ul class="service-features">
                    <li>Assignment triage & breakdown</li>
                    <li>Research assistance</li>
                    <li>"Safe Harbor" compliance</li>
                    <li>24h turnaround available</li>
                    <li>100% Confidential</li>
                </ul>
                <div class="service-proof">
                    <q>Helped me understand my dissertation structure in one session. Saved me weeks.</q>
                    <cite>— University Student, Jan 2026</cite>
                </div>
                <a href="https://sgassignmenthelp.com" class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="trackCTA('services_academic')">
                    Visit Website →
                </a>
            </div>

            <!-- Pillar 2: Web Development (The System) -->
            <div class="service-card featured">
                <span class="service-badge">Most Popular</span>
                <div class="service-icon">⚡</div>
                <h3>Web Development</h3>
                <div class="service-price">Start from $500 <span>one-time</span></div>
                <p class="service-description">
                    Production-grade static websites that load instantly. No servers to manage. No monthly fees. Built for conversion.
                </p>
                <ul class="service-features">
                    <li>5-7 page custom build</li>
                    <li>Astro v5+ (Zero JS by default)</li>
                    <li>WhatsApp + Form integration</li>
                    <li>Perfect Lighthouse Scores</li>
                    <li>Google Business setup</li>
                    <li>7-14 day delivery</li>
                </ul>
                <div class="service-proof">
                    <q>From brief to live site in under a day. The AI-augmented workflow is real.</q>
                    <cite>— SG Assignment Helpers, Education SME</cite>
                </div>
                <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'm%20interested%20in%20a%20free%20site%20audit%20for%20my%20business."
                    class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="trackCTA('services_webdev')">
                    Get a Free Site Audit →
                </a>
                <div style="text-align: center; margin-top: 0.75rem;">
                    <a href="/portfolio/" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">View Portfolio Projects →</a>
                </div>
            </div>

            <!-- Pillar 2b: AI Training & Workshops (Validated 2026 Offer) -->
            <div class="service-card featured">
                <span class="service-badge">Validated 2026</span>
                <div class="service-icon">🧠</div>
                <h3>AI Training & Workshops</h3>
                <div class="service-price">From $800 <span>per workshop</span></div>
                <p class="service-description">
                    Hands-on Claude & agentic-AI training for founders and teams. We automate YOUR real workflows live in the session — quoting, customer handling, reporting.
                </p>
                <ul class="service-features">
                    <li>Half-day hands-on workshop</li>
                    <li>Claude Code + agent setup on your machine</li>
                    <li>Your actual workflows automated live</li>
                    <li>Team playbook + session recording</li>
                    <li>30-day WhatsApp support</li>
                    <li>$800-$1,500 by team size</li>
                </ul>
                <div class="service-proof">
                    <q>Validated with paying SME clients across 2026. The same bionic pipeline that runs my own operation.</q>
                    <cite>— Built on 1,900+ logged Athena sessions</cite>
                </div>
                <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'm%20interested%20in%20AI%20training%20for%20my%20team."
                    class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="trackCTA('services_ai_training')">
                    Book a Training Slot →
                </a>
                <div style="text-align: center; margin-top: 0.75rem;">
                    <a href="/athena/" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">See the system I teach →</a>
                </div>
            </div>

            <!-- Pillar 3: AI Agents (Custom Build) -->
            <div class="service-card">
                <div class="service-icon">🤖</div>
                <h3>AI Agents & Automation</h3>
                <div class="service-price">POA</div>
                <p class="service-description">
                    Custom internal tools powered by Claude Fable 5 & Gemini 3.1 Pro. Automate your ops, customer service, and data analysis.
                </p>
                <ul class="service-features">
                    <li>RAG Knowledge Bases</li>
                    <li>Telegram/WhatsApp Bots</li>
                    <li>Lead Qualification Agents</li>
                    <li>Multi-LLM Orchestration</li>
                    <li>Local-first Data Privacy</li>
                </ul>
                <div class="service-proof">
                    <q>Custom AI agent that qualifies leads and generates proposals — automatically, 24/7.</q>
                    <cite>— Service-Led Diagnostic Gem (Live Demo)</cite>
                </div>
                <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'd%20like%20a%20free%20workflow%20assessment%20for%20AI%20automation."
                    class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="trackCTA('services_ai')">
                    Get a Free Workflow Assessment →
                </a>
                <div style="text-align: center; margin-top: 0.75rem;">
                    <a href="/projects/gem-agent/" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">See Diagnostic Agent Demo →</a>
                </div>
            </div>

            <!-- Pillar 4: Student Portfolios -->
            <div class="service-card">
                <div class="service-icon">🫡</div>
                <h3>Student Portfolios</h3>
                <div class="service-price">Start from $500 <span>one-time</span></div>
                <p class="service-description">
                    "Bionic Branding" for scholarship candidates. We build high-trust, narrative-first personal sites that stand out.
                </p>
                <ul class="service-features">
                    <li>Narrative Engineering</li>
                    <li>Bento Grid Design</li>
                    <li>"Soulful Stoic" Protocol</li>
                    <li>Application Strategy</li>
                    <li>SEO for your name</li>
                </ul>
                <div class="service-proof">
                    <q>High-trust, narrative-first personal site — complete brand identity delivered in 48 hours.</q>
                    <cite>— "The Soulful Stoic" concept build (see case study)</cite>
                </div>
                <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'm%20interested%20in%20a%20Student%20Portfolio."
                    class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="trackCTA('services_portfolio')">
                    Build My Brand →
                </a>
                <div style="text-align: center; margin-top: 0.75rem;">
                    <a href="/articles/soulful-stoic-protocol/" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">Read Case Study →</a>
                </div>
            </div>

            <!-- Pillar 5: Digital Marketing -->
            <div class="service-card">
                <div class="service-icon">📈</div>
                <h3>Digital Marketing</h3>
                <div class="service-price">
                    <span style="display: block; font-size: 1.5rem;">From $500 Setup</span>
                    <span style="display: block; font-size: 1rem; color: var(--text-muted);">+ % Ad Spend</span>
                </div>
                <p class="service-description">
                    Full-stack traffic systems. We use Athena to generate high-intent keywords and ad copy that actually converts.
                </p>
                <ul class="service-features">
                    <li>Google / FB / TikTok Ads</li>
                    <li>Landing Page Optimization</li>
                    <li>Funnel Architecture</li>
                    <li>ROI Tracking</li>
                    <li>Athena Copywriting Engine</li>
                </ul>
                <div class="service-proof">
                    <q>Complete 90-day roadmap with ROI projections — delivered in 24 hours.</q>
                    <cite>— Swim-coach growth proposal, concept build (see strategy deck)</cite>
                </div>
                <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'm%20interested%20in%20Digital%20Marketing."
                    class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="trackCTA('services_marketing')">
                    Start Growing →
                </a>
                <div style="text-align: center; margin-top: 0.75rem;">
                    <a href="/projects/thatbiotutor/" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">View Strategy Deck →</a>
                </div>
            </div>

            <!-- Pillar 6: Consulting (Zoom) -->
            <div class="service-card">
                <div class="service-icon">🤝</div>
                <h3>Consulting</h3>
                <div class="service-price">$150 <span>nett / hr</span></div>
                <p class="service-description">
                    1-on-1 strategic clarity. We solve your specific blockers over Zoom. No fluff, just answers.
                </p>
                <ul class="service-features">
                    <li>60-Minute Zoom call</li>
                    <li>Strategic Problem Solving</li>
                    <li>Session Recording Provided</li>
                    <li>Actionable Next Steps</li>
                    <li>Direct Access to Winston</li>
                </ul>
                <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'd%20like%20to%20book%20a%20free%2015-min%20strategy%20call."
                    class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="trackCTA('services_consulting')">
                    Book a Free 15-Min Call →
                </a>
            </div>
        </section>

        <!-- Service Bundles (Explicit Savings) -->
        <section class="bundle-section">
            <h2>Save More with Bundles</h2>
            <p class="bundle-subtitle">Multi-service packages with transparent savings. No hidden fees.</p>
            <div class="bundle-grid">
                <div class="bundle-card">
                    <div class="bundle-name">🚀 Launchpad</div>
                    <div class="bundle-price">$800 <span class="bundle-original">$900</span></div>
                    <div class="bundle-savings">SAVE $100</div>
                    <ul class="bundle-includes">
                        <li>Full website build (5-7 pages)</li>
                        <li>SEO audit & optimization</li>
                        <li>Google Business setup</li>
                        <li>30-day support window</li>
                    </ul>
                    <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'm%20interested%20in%20the%20Launchpad%20bundle."
                        class="bundle-cta" target="_blank" rel="noopener noreferrer"
                        onclick="trackCTA('bundle_launchpad')">
                        Get Launchpad →
                    </a>
                </div>
                <div class="bundle-card bundle-featured">
                    <span class="service-badge">Best Value</span>
                    <div class="bundle-name">🔥 Growth Engine</div>
                    <div class="bundle-price">$1,600 <span class="bundle-original">$2,000</span></div>
                    <div class="bundle-savings">SAVE $400</div>
                    <ul class="bundle-includes">
                        <li>Full website build (5-7 pages)</li>
                        <li>AI agent / chatbot integration</li>
                        <li>Digital marketing setup</li>
                        <li>Landing page optimization</li>
                        <li>60-day support window</li>
                    </ul>
                    <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'm%20interested%20in%20the%20Growth%20Engine%20bundle."
                        class="bundle-cta" target="_blank" rel="noopener noreferrer"
                        onclick="trackCTA('bundle_growth')">
                        Get Growth Engine →
                    </a>
                </div>
                <div class="bundle-card">
                    <div class="bundle-name">💎 Full Stack</div>
                    <div class="bundle-price">$2,800 <span class="bundle-original">$3,500</span></div>
                    <div class="bundle-savings">SAVE $700</div>
                    <ul class="bundle-includes">
                        <li>Everything in Growth Engine</li>
                        <li>Custom AI automation build</li>
                        <li>Ongoing consulting retainer</li>
                        <li>Priority support channel</li>
                        <li>Quarterly strategy review</li>
                    </ul>
                    <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'm%20interested%20in%20the%20Full%20Stack%20bundle."
                        class="bundle-cta" target="_blank" rel="noopener noreferrer"
                        onclick="trackCTA('bundle_fullstack')">
                        Get Full Stack →
                    </a>
                </div>
            </div>
        </section>

        <!-- Guarantee Section -->
        <section class="guarantee-section">
            <div class="guarantee-icon">🛡️</div>
            <h2>The "No Fluff" Guarantee</h2>
            <p>
                You own everything. No monthly fees. No vendor lock-in. Your code lives in your GitHub, hosted free on
                GitHub Pages. If you're not happy within 14 days, I'll refund your payment.
            </p>
        </section>

        <!-- Comprehensive FAQ -->
        <section class="services-faq">
            <h2>Frequently Asked Questions</h2>
            <div class="faq-accordion">
                <div class="faq-item">
                    <button class="faq-question" aria-expanded="false">
                        <span>How long does a project take?</span>
