---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services | Fixed-Price AI & Full-stack Development | Winston Koh" description="Production-ready AI systems and SME websites. Landing pages, LLM integration, and bionic automation. 24-72 hour delivery with fixed pricing.">
    <!-- Services Page Specific Styles -->
    <style>
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .service-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2.5rem;
            position: relative;
            transition: border-color 0.3s, transform 0.3s;
        }

        .service-card:hover {
            border-color: var(--accent-primary);
            transform: translateY(-4px);
        }

        .service-card.featured {
            border-color: var(--accent-primary);
            background: rgba(59, 130, 246, 0.03);
        }

        .service-badge {
            position: absolute;
            top: -12px;
            right: 24px;
            background: var(--accent-primary);
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 0.35rem 0.75rem;
            border-radius: 100px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .service-icon {
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
        }

        .service-card h3 {
            font-family: 'Outfit', sans-serif;
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .service-price {
            font-size: 2rem;
            font-weight: 700;
            color: var(--accent-primary);
            margin: 1rem 0;
        }

        .service-price span {
            font-size: 1rem;
            font-weight: 400;
            color: var(--text-muted);
        }

        .service-description {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
            line-height: 1.6;
        }

        .service-features {
            list-style: none;
            margin-bottom: 2rem;
        }

        .service-features li {
            padding: 0.5rem 0;
            padding-left: 1.5rem;
            position: relative;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .service-features li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--accent-primary);
            font-weight: bold;
        }

        .service-cta {
            display: block;
            text-align: center;
            padding: 1rem;
            background: var(--accent-primary);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            transition: background 0.2s, transform 0.2s;
        }

        .service-cta:hover {
            background: #2563eb;
            transform: translateY(-2px);
        }

        .service-card.featured .service-cta {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        }

        /* Guarantee Section */
        .guarantee-section {
            text-align: center;
            padding: 4rem 2rem;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            margin-top: 4rem;
        }

        .guarantee-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .guarantee-section h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 1.75rem;
            margin-bottom: 1rem;
        }

        .guarantee-section p {
            color: var(--text-muted);
            max-width: 500px;
            margin: 0 auto;
        }

        /* FAQ Quick Links */
        .services-faq {
            margin-top: 4rem;
        }

        .services-faq h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            text-align: center;
        }
    </style>

    <section class="page-content">
        <section class="page-header">
            <h1>Services</h1>
            <p class="page-subtitle">Fixed pricing. Fast delivery. Systems that work.</p>
        </section>

        <section class="services-grid">
            <!-- Pillar 1: Academic Consulting (Backlink Strategy) -->
            <div class="service-card">
                <div class="service-icon">🎓</div>
                <h3>Academic Consulting</h3>
                <div class="service-price">SG Assignment Helper</div>
                <p class="service-description">
                    Premium academic guidance and triage for university students. We help you deconstruct complex assignments using First Principles.
                </p>
                <ul class="service-features">
                    <li>Assignment triage & breakdown</li>
                    <li>Research assistance</li>
                    <li>"Safe Harbor" compliance</li>
                    <li>24h turnaround available</li>
                    <li>100% Confidential</li>
                </ul>
                <a href="https://sgassignmenthelp.com" class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="gtag('event', 'cta_click', {'cta_name': 'services_academic'})">
                    Visit Website →
                </a>
            </div>

            <!-- Pillar 2: Web Development (The System) -->
            <div class="service-card featured">
                <span class="service-badge">Most Popular</span>
                <div class="service-icon">⚡</div>
                <h3>Web Development</h3>
                <div class="service-price">Start from $500 <span>one-time</span></div>
                <p class="service-description">
                    Production-grade static websites that load instantly. No servers to manage. No monthly fees. Built for conversion.
                </p>
                <ul class="service-features">
                    <li>5-7 page custom build</li>
                    <li>Astro v5+ (Zero JS by default)</li>
                    <li>WhatsApp + Form integration</li>
                    <li>Perfect Lighthouse Scores</li>
                    <li>Google Business setup</li>
                    <li>7-14 day delivery</li>
                </ul>
                <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'm%20interested%20in%20The%20System%20(Web%20Dev)%20package."
                    class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="gtag('event', 'cta_click', {'cta_name': 'services_webdev'})">
                    Get Started →
                </a>
                <div style="text-align: center; margin-top: 0.75rem;">
                    <a href="/portfolio" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">View Portfolio Projects →</a>
                </div>
            </div>

            <!-- Pillar 3: AI Agents (Custom Build) -->
            <div class="service-card">
                <div class="service-icon">🤖</div>
                <h3>AI Agents & Automation</h3>
                <div class="service-price">POA</div>
                <p class="service-description">
                    Custom internal tools powered by Claude 4.5 & Gemini 3.5 Ultra. Automate your ops, customer service, and data analysis.
                </p>
                <ul class="service-features">
                    <li>RAG Knowledge Bases</li>
                    <li>Telegram/WhatsApp Bots</li>
                    <li>Lead Qualification Agents</li>
                    <li>Multi-LLM Orchestration</li>
                    <li>Local-first Data Privacy</li>
                </ul>
                <a href="https://tally.so/r/3xjo1O" class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="gtag('event', 'cta_click', {'cta_name': 'services_ai'})">
                    Discuss Project →
                </a>
                <div style="text-align: center; margin-top: 0.75rem;">
                    <a href="/projects/gem-agent" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">See Diagnostic Agent Demo →</a>
                </div>
            </div>

            <!-- Pillar 4: Student Portfolios -->
            <div class="service-card">
                <div class="service-icon">🫡</div>
                <h3>Student Portfolios</h3>
                <div class="service-price">Start from $500 <span>one-time</span></div>
                <p class="service-description">
                    "Bionic Branding" for scholarship candidates. We build high-trust, narrative-first personal sites that stand out.
                </p>
                <ul class="service-features">
                    <li>Narrative Engineering</li>
                    <li>Bento Grid Design</li>
                    <li>"Soulful Stoic" Protocol</li>
                    <li>Application Strategy</li>
                    <li>SEO for your name</li>
                </ul>
                <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'm%20interested%20in%20a%20Student%20Portfolio."
                    class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="gtag('event', 'cta_click', {'cta_name': 'services_portfolio'})">
                    Build My Brand →
                </a>
                <div style="text-align: center; margin-top: 0.75rem;">
                    <a href="/articles/soulful-stoic-protocol/" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">Read Case Study →</a>
                </div>
            </div>

            <!-- Pillar 5: Digital Marketing -->
            <div class="service-card">
                <div class="service-icon">📈</div>
                <h3>Digital Marketing</h3>
                <div class="service-price">
                    <span style="display: block; font-size: 1.5rem;">From $500 Setup</span>
                    <span style="display: block; font-size: 1rem; color: var(--text-muted);">+ % Ad Spend</span>
                </div>
                <p class="service-description">
                    Full-stack traffic systems. We use Athena to generate high-intent keywords and ad copy that actually converts.
                </p>
                <ul class="service-features">
                    <li>Google / FB / TikTok Ads</li>
                    <li>Landing Page Optimization</li>
                    <li>Funnel Architecture</li>
                    <li>ROI Tracking</li>
                    <li>Athena Copywriting Engine</li>
                </ul>
                <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'm%20interested%20in%20Digital%20Marketing."
                    class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="gtag('event', 'cta_click', {'cta_name': 'services_marketing'})">
                    Start Growing →
                </a>
                <div style="text-align: center; margin-top: 0.75rem;">
                    <a href="/projects/thatbiotutor" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">View Strategy Deck →</a>
                </div>
            </div>

            <!-- Pillar 6: Consulting (Zoom) -->
            <div class="service-card">
                <div class="service-icon">🤝</div>
                <h3>Consulting</h3>
                <div class="service-price">$150 <span>nett / hr</span></div>
                <p class="service-description">
                    1-on-1 strategic clarity. We solve your specific blockers over Zoom. No fluff, just answers.
                </p>
                <ul class="service-features">
                    <li>60-Minute Zoom call</li>
                    <li>Strategic Problem Solving</li>
                    <li>Session Recording Provided</li>
                    <li>Actionable Next Steps</li>
                    <li>Direct Access to Winston</li>
                </ul>
                <a href="https://wa.me/6583581066?text=Hi%20Winston%2C%20I'd%20like%20to%20book%20a%20Consulting%20session."
                    class="service-cta" target="_blank" rel="noopener noreferrer"
                    onclick="gtag('event', 'cta_click', {'cta_name': 'services_consulting'})">
                    Book Session →
                </a>
            </div>
        </section>

        <!-- Guarantee Section -->
        <section class="guarantee-section">
            <div class="guarantee-icon">🛡️</div>
            <h2>The "No Fluff" Guarantee</h2>
            <p>
                You own everything. No monthly fees. No vendor lock-in. Your code lives in your GitHub, hosted free on
                GitHub Pages. If you're not happy within 14 days, I'll refund your payment.
            </p>
        </section>

        <!-- Comprehensive FAQ -->
        <section class="services-faq">
            <h2>Frequently Asked Questions</h2>
            <div class="faq-accordion">
                <div class="faq-item">
                    <button class="faq-question" aria-expanded="false">
                        <span>How long does a project take?</span>
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        <p>Most websites go from brief to live in <strong>24-72 hours</strong>. Complex projects with
                            custom features may take 1-2 weeks.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question" aria-expanded="false">
                        <span>What do I need to provide?</span>
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        <p>A <strong>clear brief</strong>: what you do, who you serve, and what action you want visitors
                            to take. I handle the rest — design, copy suggestions, and technical implementation.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question" aria-expanded="false">
                        <span>Is there ongoing maintenance?</span>
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        <p>Not required. Your site is <strong>static HTML</strong> hosted on GitHub Pages — no servers
                            to maintain, no plugins to update, no monthly fees.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question" aria-expanded="false">
                        <span>What if I need changes later?</span>
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        <p>Simple edits are quick and included in the 30-day window. Larger feature additions are quoted
                            separately. Everything stays in Git — <strong>nothing is ever lost</strong>.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question" aria-expanded="false">
                        <span>What framework do you use?</span>
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        <p><strong>Astro with optional React components.</strong> I use Astro for its "Islands Architecture" — 
                            zero JavaScript by default, but I can add React components when interactivity is needed.
                            This gives you <strong>faster load times</strong> without sacrificing capability. 
                            The right tool for the right job.</p>
                    </div>
                </div>
            </div>
        </section>

    </section>

    <script is:inline>
        // FAQ Accordion Functionality
        document.addEventListener('DOMContentLoaded', function () {
            const faqQuestions = document.querySelectorAll('.faq-question');

            faqQuestions.forEach(question => {
                question.addEventListener('click', function () {
                    const faqItem = this.parentElement;
                    const icon = this.querySelector('.faq-icon');
                    const isOpen = this.getAttribute('aria-expanded') === 'true';

                    // Close all other FAQs
                    faqQuestions.forEach(q => {
                        if (q !== this) {
                            q.setAttribute('aria-expanded', 'false');
                            q.parentElement.classList.remove('active');
                            q.querySelector('.faq-icon').textContent = '+';
                        }
                    });

                    // Toggle current FAQ
                    this.setAttribute('aria-expanded', !isOpen);
                    faqItem.classList.toggle('active');
                    icon.textContent = isOpen ? '+' : '−';
                });
            });
        });
    </script>

    <!-- FAQ Schema (SEO) -->
    <script type="application/ld+json" is:inline>
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [{
            "@type": "Question",
            "name": "What is a Bionic Unit?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A Bionic Unit is a human-AI hybrid workflow where cognitive labor is shared. Unlike standard 'AI assistance', a Bionic Unit integrates AI into the core execution loop, allowing for 10x leverage in output quality and speed."
            }
          }, {
            "@type": "Question",
            "name": "Do you offer Consulting?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. I offer fixed-price strategic consulting sessions ($150 nett/hr) conducted via Zoom. These are high-intensity problem-solving sessions designed to unblock systems or architecture issues immediately."
            }
          }, {
            "@type": "Question",
            "name": "What is the Anti-Slop Protocol?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The Anti-Slop Protocol is my zero-tolerance quality standard. It rejects generic 'ChatGPT-sounding' output in favor of First Principles thinking, specific data citations, and high-density insight. If it looks like AI wrote it, it doesn't ship."
            }
          }]
        }
    </script>
</Layout>
