import { ATHENA_VERSION, PROTOCOLS_ACTIVE, SESSIONS_LOGGED, SESSIONS_MILESTONE, GITHUB_STARS } from '../data/site-stats';

const faqData = [
    { question: "What exactly is Athena?", answer: `Athena is an open-source operating system for AI agents. It gives any LLM persistent memory, structured reasoning, and governance — so your ${SESSIONS_MILESTONE} session recalls patterns from your 5th. Think of it as the hard drive that ChatGPT is missing.` },
    { question: "How is this different from using ChatGPT or Claude directly?", answer: "ChatGPT and Claude are engines — powerful but amnesiac. Every session starts from zero. Athena wraps around any model to provide persistent memory, skill injection, and bounded autonomy. When you switch models, your memory stays mounted." },
    { question: "Do I need to know how to code?", answer: "No. Athena boots with a single command (/start) and requires no API keys, no database setup, and no config files. The folder is the product. If you can type in a chat window, you can use Athena." },
    { question: "What does a typical engagement look like?", answer: "For freelance projects: We start with a WhatsApp call to scope the work, I deliver a fixed-price proposal within 24 hours, and most projects ship within 1-2 weeks. For Athena consulting: I help you set up the system, build your initial memory bank, and train your team in a half-day workshop." },
    { question: "Do you run AI training for teams?", answer: "Yes — hands-on AI agent training is my most requested service in 2026. I train founders and teams to run Claude and agentic workflows on their real business processes: quoting, customer handling, reporting, content. Half-day workshop format, from $800, validated with paying SME clients. You leave with working automations, not slideware." },
    { question: "What's your pricing?", answer: "Fixed pricing, no hourly billing. Websites from $500, AI training workshops from $800, consulting at $150/hr, custom AI agent builds by scope. Every project starts with a scoped proposal so you know exactly what you're getting — no surprises, no hourly clock. Message me and I'll send a proposal within 24 hours." }
];

// Single source of truth for freshness — matches the footer's build-time date
const lastVerified = new Date().toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', year: 'numeric', month: 'short', day: 'numeric' });

const metaDescription = `Singapore AI Systems Architect. ${GITHUB_STARS}★ open-source AI OS (Athena), ${SESSIONS_LOGGED} logged sessions, sites shipped in 24-72h. Fixed pricing, AI training from $800. WhatsApp me →`;
