    <!-- ATHENA PSEUDO-API TERMINAL SCRIPT -->
    <script is:inline define:vars={{ ATHENA_VERSION, PROTOCOLS_ACTIVE, SESSIONS_LOGGED }}>
        // ========================================
        // ATHENA KNOWLEDGE BASE (Loaded from external JSON)
        // ========================================
        let ATHENA_KNOWLEDGE = {};
        
        // Fetch knowledge base from external JSON
        fetch('/data/athena_kb.json')
            .then(res => res.json())
            .then(data => { ATHENA_KNOWLEDGE = data; })
            .catch(err => console.warn('Failed to load knowledge base:', err));

        // Intent aliases: natural-language tokens → knowledge base key.
        // Lets "how much do you charge?" resolve to the pricing entry instead of the fallback.
        const INTENT_ALIASES = {
            pricing: ['pricing', 'price', 'prices', 'cost', 'costs', 'charge', 'charges', 'rate', 'rates', 'fee', 'fees', 'expensive', 'cheap', 'budget', 'quote'],
            hire: ['hire', 'hiring', 'freelance', 'engage', 'build', 'website', 'websites', 'site', 'sites', 'landing', 'ecommerce', 'e-commerce', 'app', 'commission', 'work'],
            contact: ['contact', 'reach', 'email', 'whatsapp', 'telegram', 'phone', 'call', 'message', 'talk'],
            projects: ['projects', 'project', 'portfolio', 'built', 'works', 'clients', 'showcase'],
            stack: ['stack', 'tech', 'technology', 'technologies', 'tools', 'languages', 'framework', 'frameworks'],
            athena: ['athena', 'memory', 'agent', 'agents', 'rag', 'protocols', 'os'],
            availability: ['availability', 'available', 'free', 'when', 'timeline', 'turnaround', 'schedule']
        };

        function findAnswer(query) {
            const q = query.toLowerCase().trim();

            // 1. Direct match
            if (ATHENA_KNOWLEDGE[q]) {
                return ATHENA_KNOWLEDGE[q];
            }

            const tokens = q.replace(/[^a-z0-9\s-]/g, '').split(/\s+/).filter(Boolean);

            // 2. Exact KB key appears as a word in the query (longest key wins)
            const kbKeys = Object.keys(ATHENA_KNOWLEDGE).sort((a, b) => b.length - a.length);
            for (const key of kbKeys) {
                if (tokens.includes(key) || (key.includes(' ') && q.includes(key))) {
                    return ATHENA_KNOWLEDGE[key];
                }
            }

            // 3. Intent aliases — score by number of alias hits, best intent wins
            let bestIntent = null, bestScore = 0;
            for (const [intent, aliases] of Object.entries(INTENT_ALIASES)) {
                const score = tokens.filter(t => aliases.includes(t)).length;
                if (score > bestScore && ATHENA_KNOWLEDGE[intent]) {
                    bestScore = score;
                    bestIntent = intent;
                }
            }
            if (bestIntent) {
                return ATHENA_KNOWLEDGE[bestIntent];
            }

            // Capture Hook: Log missed queries for "Bionic" improvement
            console.log(`[ATHENA CAPTURE] Thinking about: "${query}" (No direct match found. Logging for knowledge base expansion.)`);

            // Fallback responses
            const fallbacks = [
                `I don't have specific info on "${query}" yet. I've logged this for future updates. Try asking about: projects, stack, or pricing.`,
                `Hmm, that's outside my current index. I've flagged "${query}" for Winston to review. Type 'help' to see my active protocols.`,
                `Knowledge gap detected for "${query}". Query logged. Try asking about Winston's projects, pricing, or tech stack.`
            ];
            return fallbacks[Math.floor(Math.random() * fallbacks.length)];
        }

        // Terminal DOM elements
        const terminalHistory = document.getElementById('terminal-history');
        const termInput = document.getElementById('term-input');
        const termBody = document.getElementById('terminal-body');

        function logToTerminal(text, type = 'user') {
            const div = document.createElement('div');
            div.className = `log-entry ${type}`;
            div.style.whiteSpace = 'pre-wrap';
            div.innerText = text;
            terminalHistory.appendChild(div);
            // Scroll only the terminal container, not the page
            termBody.scrollTop = termBody.scrollHeight;
        }

        function typeWriterResponse(text, callback) {
            const div = document.createElement('div');
            div.className = 'log-entry ai';
            div.style.whiteSpace = 'pre-wrap';
            terminalHistory.appendChild(div);

            // Time-based typing: chars shown are computed from elapsed time, so the
            // animation catches up instantly after any timer throttling (hidden tabs)
            // and long answers never take longer than MAX_DURATION.
            const CHARS_PER_SEC = 90;
            const MAX_DURATION = 2000; // ms
            const duration = Math.min((text.length / CHARS_PER_SEC) * 1000, MAX_DURATION);
            const start = performance.now();

            function finish() {
                // Linkify after typing
                const linkified = text.replace(/(\/[a-zA-Z0-9_-]+)/g, (match) => {
                    if (match === '/help' || match === '/clear') return match;
                    return `<a href="${match}" class="terminal-link">${match}</a>`;
                });
                div.innerHTML = linkified;
                termBody.scrollTop = termBody.scrollHeight;
                if (callback) callback();
            }

            function type() {
                const progress = Math.min((performance.now() - start) / duration, 1);
                const chars = Math.floor(progress * text.length);
                div.innerText = text.slice(0, chars);
                termBody.scrollTop = termBody.scrollHeight;
                if (progress < 1) {
                    setTimeout(type, 40);
                } else {
                    finish();
                }
            }
            type();
        }

        // Handle input
        termInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                const text = termInput.value.trim();
                if (!text) return;
                
                // Log user input
                const promptText = document.getElementById('term-prompt').innerText;
                logToTerminal(`${promptText} ${text}`, 'user');
                termInput.value = '';

                // Handle commands
                if (text.toLowerCase() === 'help') {
                    logToTerminal(`Available commands:
• help — Show this menu
• clear — Clear terminal
• projects — List Winston's work
• stack — Tech stack overview
• pricing — Freelance rates
• contact — Get in touch

Or just ask a question naturally!`, 'system');
                } else if (text.toLowerCase() === 'clear') {
                    terminalHistory.innerHTML = '';
                    logToTerminal('Terminal cleared.', 'system');
                } else {
                    // Simulate thinking delay
                    setTimeout(() => {
                        const answer = findAnswer(text);
                        typeWriterResponse(answer);
                    }, 300);
                }
            }
        });

        // Boot sequence
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => logToTerminal(`Initializing Athena Protocol ${ATHENA_VERSION}...`, 'system'), 500);
            setTimeout(() => logToTerminal(`Knowledge base loaded. ${PROTOCOLS_ACTIVE} protocols active. ${SESSIONS_LOGGED} sessions recalled.`, 'system'), 1200);
            setTimeout(() => typeWriterResponse('Welcome! I\'m Athena, Winston\'s AI assistant. Ask me about his projects, tech stack, or how to hire him.'), 1800);
        });
    </script>

    <!-- Intent Engine Script -->
    <script is:inline define:vars={{ ATHENA_VERSION, SESSIONS_LOGGED }}>
        const INTENT_DATA = {
            freelance: {
                headline: "AI Systems Architect<br>I build <span class='text-gradient'>agentic PKM infrastructure.</span>",
                subtitle: "24-72hr Delivery • Perfect Lighthouse Scores • Fixed Pricing",
                desc: "Stop renting your brain from OpenAI. I build local-first AI architectures (Athena) with permanent, owned memory — and production-grade websites for SMEs that load instantly.",
                cta: "Let's Talk",
                ctaLink: "https://wa.me/6583581066?text=Hi%20Winston%2C%20I%20came%20across%20your%20site%20and%20wanted%20to%20connect.",
                showSecondary: false
            },
            fulltime: {
                headline: "Full-Stack Engineer<br>with <span class='text-gradient'>AI Specialization.</span>",
                subtitle: "Python • JavaScript • RAG • Agentic Orchestration",
                desc: `I build production-grade applications with Claude Fable 5, Gemini 3.1 Pro, and multi-LLM pipelines. Creator of Athena ${ATHENA_VERSION} (${SESSIONS_LOGGED} sessions).`,
                cta: "Try The Simulation",
                ctaLink: "https://github.com/winstonkoh87/Athena-Public",
                showSecondary: true,
                secondaryText: "Download Resume",
                secondaryLink: "/Winston Koh - Resume.pdf"
            }
        };

        function setIntent(mode, animate = true) {
            // 1. Visual Toggle State
            const btns = document.querySelectorAll('.intent-btn');
            btns.forEach(b => b.classList.remove('active'));
            document.getElementById(`btn-${mode}`).classList.add('active');

            // 2. CSS Theme Swap
            if (mode === 'fulltime') {
                document.body.classList.add('fulltime-mode');
            } else {
                document.body.classList.remove('fulltime-mode');
            }

            // 3. Content Injection
            const data = INTENT_DATA[mode];
            const elements = [
                document.getElementById('hero-headline'),
                document.getElementById('hero-subtitle'),
                document.getElementById('hero-description'),
                document.getElementById('hero-cta-btn'),
                document.getElementById('hero-secondary-btn')
            ];

            // Helper to swap text
            const swapText = () => {
                const headline = document.getElementById('hero-headline');
                const subtitle = document.getElementById('hero-subtitle');
                const description = document.getElementById('hero-description');
                const ctaBtn = document.getElementById('hero-cta-btn');
                const secondaryBtn = document.getElementById('hero-secondary-btn');

                if (headline) headline.innerHTML = data.headline;
                if (subtitle) subtitle.innerHTML = data.subtitle;
                if (description) description.innerHTML = data.desc;
                if (ctaBtn) {
                    ctaBtn.innerHTML = data.cta;
                    ctaBtn.href = data.ctaLink;
                }
                if (secondaryBtn) {
                    if (data.showSecondary) {
                        secondaryBtn.style.display = 'inline-block';
                        secondaryBtn.innerHTML = data.secondaryText;
                        secondaryBtn.href = data.secondaryLink;
                    } else {
                        secondaryBtn.style.display = 'none';
                    }
                }
            };

            if (animate) {
                // Fade out
                elements.forEach(el => {
                    if (el) el.style.opacity = '0';
                });

                setTimeout(() => {
                    swapText();
                    // Fade in
                    elements.forEach(el => {
                        if (el) {
                            el.style.opacity = '1';
                            el.style.transition = 'opacity 0.4s ease';
                        }
                    });
                }, 250);
            } else {
                // Instant update (No animation)
                swapText();
                // Ensure visibility and clean styles
                elements.forEach(el => {
                    if (el) {
                        el.style.opacity = '';
                        el.style.transition = '';
                    }
                });
            }

            // 4. Save preference
            localStorage.setItem('intent_mode', mode);
        }

        // Expose to global scope (define:vars wraps in IIFE)
        window.setIntent = setIntent;

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            const savedMode = localStorage.getItem('intent_mode') || 'freelance';
            setIntent(savedMode, false);
        });
    </script>
</Layout>
