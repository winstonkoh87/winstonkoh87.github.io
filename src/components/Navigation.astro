---
const pathname = Astro.url.pathname;
---
<nav>
    <a href="/" class="logo">WK</a>
    <ul>
        <li><a href="/portfolio/" class={pathname.startsWith('/portfolio') ? 'active' : ''}>Portfolio</a></li>
        <li><a href="/writing/" class={pathname.startsWith('/writing') ? 'active' : ''}>Writing</a></li>
        <li><a href="/services/" class={pathname.startsWith('/services') ? 'active' : ''}>Services</a></li>
        <li><a href="/about/" class={pathname.startsWith('/about') ? 'active' : ''}>About</a></li>
        <li><a href="/contact/" class={pathname.startsWith('/contact') ? 'active' : ''}>Contact</a></li>
    </ul>
</nav>
