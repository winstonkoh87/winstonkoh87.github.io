---
import { getRelatedArticles } from '../data/writing-taxonomy';

interface Props {
    currentSlug: string;
    limit?: number;
}

const { currentSlug, limit = 6 } = Astro.props;
const related = getRelatedArticles(currentSlug, limit);
---

{related.length > 0 && (
    <section class="related-articles">
        <h3 class="related-heading">Keep Reading</h3>
        <div class="related-grid">
            {related.map((article) => (
                <a href={`/articles/${article.slug}/`} class="related-card">
                    <div class="related-image-wrapper">
                        <img 
                            src={article.image} 
                            alt={article.title}
                            class="related-image"
                            loading="lazy"
                        />
                    </div>
                    <div class="related-content">
                        <span class="related-tag">{article.tags[0]}</span>
                        <h4>{article.title}</h4>
                        {article.readingTime && (
                            <span class="related-reading-time">{article.readingTime} min read</span>
                        )}
                    </div>
                </a>
            ))}
        </div>
    </section>
)}

<style>
    .related-articles {
        margin-top: 3rem;
        padding-top: 2.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .related-heading {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        color: var(--text-primary, #fff);
    }

    .related-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    @media (max-width: 900px) {
        .related-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 560px) {
        .related-grid {
            grid-template-columns: 1fr;
        }
    }

    .related-card {
        text-decoration: none;
        color: inherit;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .related-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .related-image-wrapper {
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
    }

    .related-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .related-card:hover .related-image {
        transform: scale(1.05);
    }

    .related-content {
        padding: 0.75rem 0.25rem 0.5rem;
    }

    .related-tag {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--accent, #64ffda);
        margin-bottom: 0.4rem;
    }

    .related-content h4 {
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.4;
        color: var(--text-primary, #fff);
        margin: 0;
        transition: color 0.2s ease;
    }

    .related-card:hover .related-content h4 {
        color: var(--accent, #64ffda);
    }

    .related-reading-time {
        display: block;
        font-size: 0.75rem;
        color: var(--text-muted, #666);
        margin-top: 0.4rem;
    }
</style>
