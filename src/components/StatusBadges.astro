---
// StatusBadges.astro — Dynamic SVG status badge strip for live system verification
---

<div class="status-badge-container">
    <div class="badge-header">
        <span class="pulse-dot"></span>
        <span class="badge-title">REAL-TIME SYSTEM METRICS</span>
    </div>
    <div class="badge-grid">
        <a href="https://github.com/winstonkoh87/Athena-Public/releases/tag/v9.9.8" target="_blank" rel="noopener noreferrer" title="View Athena Release">
            <img src="/badges/athena-status.svg" alt="Athena Status Badge" width="220" height="28" loading="lazy" />
        </a>
        <a href="https://github.com/winstonkoh87/Athena-Public" target="_blank" rel="noopener noreferrer" title="View Active Protocols">
            <img src="/badges/protocols.svg" alt="Protocols Count Badge" width="210" height="28" loading="lazy" />
        </a>
        <a href="https://github.com/winstonkoh87/Athena-Public/blob/main/docs/BENCHMARKS.md" target="_blank" rel="noopener noreferrer" title="View RAG Benchmark Results">
            <img src="/badges/rag-benchmark.svg" alt="Hybrid RAG Benchmark Badge" width="240" height="28" loading="lazy" />
        </a>
        <a href="https://github.com/winstonkoh87/Athena-Public" target="_blank" rel="noopener noreferrer" title="View Logged Sessions">
            <img src="/badges/sessions.svg" alt="Logged Sessions Badge" width="200" height="28" loading="lazy" />
        </a>
        <a href="https://github.com/winstonkoh87/Athena-Public/actions" target="_blank" rel="noopener noreferrer" title="View GitHub Build Status">
            <img src="/badges/build-status.svg" alt="Build Status Badge" width="230" height="28" loading="lazy" />
        </a>
    </div>
</div>

<style>
    .status-badge-container {
        margin: 2rem 0;
        padding: 1.25rem 1.5rem;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(51, 65, 85, 0.5);
        border-radius: 12px;
        backdrop-filter: blur(8px);
    }
    .badge-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }
    .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 8px #22c55e;
        animation: pulse 2s infinite;
    }
    @keyframes pulse {
        0% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.9); }
        100% { opacity: 1; transform: scale(1); }
    }
    .badge-title {
        font-family: var(--font-mono, 'JetBrains Mono', monospace);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #94a3b8;
    }
    .badge-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
    }
    .badge-grid a {
        display: inline-block;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .badge-grid a:hover {
        transform: translateY(-2px);
        opacity: 0.9;
    }
    .badge-grid img {
        height: 28px;
        width: auto;
    }
</style>
